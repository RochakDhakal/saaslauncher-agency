        },
        {
          "slug": "foreground-alt",
          "color": "#B9ACD2",
          "name": "Foreground Alternative"
        },
        {
          "slug": "meta-color",
          "color": "#C0C0C0",
          "name": "Meta Color"
        },
        {
          "slug": "border-color",
          "color": "#232629",
          "name": "Border Color"
        },
        {
          "slug": "sticky-bg-color",
          "color": "#021411",
          "name": "Sticky Background Color"
        },
        {
          "color": "#ffffff00",
          "name": "Transparent",
          "slug": "transparent"
        }
      ],
      "duotone": [
        {
          "colors": ["#7B36F2", "#05000B"],
          "slug": "primary-secondary",
          "name": "Duo 1"
        },
        {
          "colors": ["#05000B", "#7B36F2"],
          "slug": "secondary-primary",
          "name": "Duo 2"
        },
        {
          "colors": ["#7B36F2", "#FFFFFE"],
          "slug": "primary-light",
          "name": "Duo 3"
        },
        {
          "colors": ["#05000B", "#FFFFFE"],
          "slug": "dark-shade",
          "name": "Dark Shade"
        },
        {
          "colors": ["#7B36F2", "#9F05F8"],
          "slug": "primary-shade",
          "name": "Duo 4"
        },
        {
          "colors": ["#9F05F8", "#000000"],
          "slug": "primary-dark",
          "name": "Duo 5"
        },
        {
          "colors": ["#000000", "#9F05F8"],
          "slug": "dark-primary",
          "name": "Duo 6"
        },
        {
          "colors": ["#9F05F8", "#FFFFFE"],
          "slug": "shade-light",
          "name": "Duo 7"
        },
        {
          "colors": ["#FFFFFE", "#9F05F8"],
          "slug": "light-shade",
          "name": "Duo 8"
        },
        {
          "colors": ["#7B36F2", "#000000"],
          "slug": "secondary-dark",
          "name": "Duo 9"
        },
        {
          "colors": ["#000000", "#7B36F2"],
          "slug": "dark-secondary",
          "name": "Duo 10"
        },
        {
          "colors": ["#FFFFFE", "#7B36F2"],
          "slug": "light-primary",
          "name": "Duo 11"
        }
      ],
      "gradients": [
        {
          "gradient": "linear-gradient(90deg, var(--wp--preset--color--primary-shade-one) 50%, var(--wp--preset--color--secondary-shade-1) 100%);",
          "name": "Gradient 1",
          "slug": "gradient-1"
        },
        {
          "gradient": "linear-gradient(90deg, var(--wp--preset--color--black-color) 0%, transparent 10.2%, transparent 20.19%, transparent 100%);",
          "name": "Gradient 2",
          "slug": "gradient-2"
        },
        {
          "gradient": "radial-gradient(50% 75% at 50% 50%, var(--wp--preset--color--secondary) 0%, var(--wp--preset--color--background) 55.33%);",
          "name": "Gradient 3",
          "slug": "gradient-3"
        }
      ]
    },
    "typography": {
      "dropCap": true,
      "fontSizes": [
        {
          "slug": "x-small",
          "size": "12px",
          "name": "Extra Small"
        },
        {
          "slug": "small",
          "size": "14px",
          "name": "Small"
        },
        {
          "slug": "normal",
          "size": "16px",
          "name": "Normal"
        },
        {
          "slug": "medium",
          "size": "18px",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "20px",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "24px",
          "name": "Extra Large"
        },
        {
          "slug": "xx-large",
          "size": "28px",
          "name": "2X Large"
        },
        {
          "slug": "xxx-large",
          "size": "34px",
          "name": "3X Large"
        },
        {
          "slug": "jumbo",
          "size": "44px",
          "name": "Jumbo"
        },
        {
          "slug": "mega",
          "size": "54px",
          "name": "Mega"
        },
        {
          "slug": "giga",
          "size": "72px",
          "name": "Giga"
        }
      ],
      "fontFamilies": [
        {
          "fontFace": [
            {
              "fontFamily": "Bricolage Grotesque",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "300 400 500 600 700",
              "src": [
                "file:./assets/fonts/bricolage-grotesque/BricolageGrotesque-VariableFont_wght.ttf"
              ]
            }
          ],
          "fontFamily": "\"Bricolage Grotesque\", sans-serif",
          "name": "Bricolage Grotesque",
          "slug": "bricolage-grotesque"
        },
        {
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "300 400 500 600 700",
              "src": ["file:./assets/fonts/inter/Inter-VariableFont_wght.ttf"]
            }
          ],
          "fontFamily": "\"Inter\", sans-serif",
          "name": "Inter",
          "slug": "inter"
        }
      ]
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp-preset--font-size--normal)",
      "color": "var(--wp--preset--color--foreground)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--light-color)"
          }
        }
      },
      "button": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size-normal)",
          "fontWeight": "500"
        },
        "spacing": {
          "padding": {
            "bottom": "16px",
            "left": "36px",
            "top": "16px",
            "right": "36px"
          }
        },
        "border": {
          "radius": "100px"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--black-color)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--secondary)",
            "text": "var(--wp--preset--color--light-color)"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--giga)",
          "fontWeight": "800",
          "lineHeight": "1.2"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--mega)",
          "fontWeight": "800",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--jumbo)",
          "fontWeight": "800",
          "lineHeight": "1.3"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "800",
          "lineHeight": "1.3"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "500"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--normal)",
          "fontWeight": "500"
        }
      },
      "heading": {
        "color": "var(--wp-preset--color--heading-color)",
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
          "fontStyle": "normal",
          "fontWeight": "800",
          "lineHeight": "var(--wp--preset--line-height--xxSmall)"
        }
      }
    },
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    }
  },
  "templateParts": [
    {
      "name": "header-pages",
      "title": "Header Pages",
      "area": "header"
    },
    {
      "name": "header",
      "title": "Header with Cover",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "sidebar",
      "title": "Sidebar",
      "area": "sidebar"
    }
  ]
}
